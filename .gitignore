# Terrain working folders. Each is one terrain's source art and the scripts
# that only ever built that terrain -- gigabytes of intermediates, and code
# too specific to be worth reading. Kept locally, never pushed.
Terrains/

# Game data. Copyrighted, large, and not ours to redistribute.
*.dir
GFX Originals/

# Output of the tools here. All reproducible with a single command.
decompressed/
extracted/
output/
output*/
tmp/

# Local editor and agent config, not part of the tool.
.claude/
.vscode/

# Previews written by extras/preview_extras_gifs.py, regenerable in one run.
extras/previews/

# Python
__pycache__/
*.py[cod]

# macOS
.DS_Store

# ...except under test/, where both the archive and what this tool makes of it
# are the fixtures. They are game files, but small ones, and checking a decoder
# against a description of a file rather than the file itself is no check.
!test/**/*.dir
!test/**/decompressed/
!test/**/decompressed/**

# ...but not the Finder's droppings, which the un-ignore above would otherwise
# pull back in after .DS_Store had already excluded them.
.DS_Store
**/.DS_Store
